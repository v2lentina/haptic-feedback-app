{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Android",
			"cwd": "${workspaceFolder}/HapticFeedbackApp",
			"enableDebug": true,
			"trace": "verbose",
			"suppressMultipleSessionWarning": false,
			"debuggerWorkerUrlPath": "",
			"type": "reactnative",
			"request": "launch",
			"platform": "android"
		},
		{
			"type": "monkeyc",
			"request": "launch",
			"name": "Run Garmin",
			"stopAtLaunch": false,
			"cwd": "${workspaceFolder}/garmin",
			"device": "${command:GetTargetDevice}",
		}
	]
}